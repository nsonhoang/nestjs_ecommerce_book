{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "dtoFileNameSuffix": [".dto.ts", ".response.ts", ".request.ts", ".dto.request.ts"]
        }
      }
    ],
    "assets": [
      {
        "include": "modules/mail/template/*.hbs",
        "watch": true
      }
    ]
  }
}
